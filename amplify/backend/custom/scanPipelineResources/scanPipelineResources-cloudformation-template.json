            "IndexName": "byPet",
            "KeySchema": [
              {
                "AttributeName": "petId",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "loggedAt",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "byUser",
            "KeySchema": [
              {
                "AttributeName": "userId",
                "KeyType": "HASH"
              },
              {
