                  "petvue-bookings",
                  {
                    "Ref": "env"
                  }
                ]
              ]
            }
          ]
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "bookingId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "userId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "petId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "scheduledAt",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "bookingId",
